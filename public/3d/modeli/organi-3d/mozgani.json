 "podrobnosti": {
  "naslov": "Možgani",
  "odseki": [
   {
    "naslov": "Zgradba",
    "besedilo": "Možgani odraslega človeka tehtajo okoli 1,3 do 1,4 kilograma. Sestavljajo jih veliki možgani, mali možgani in možgansko deblo. Veliki možgani imajo levo in desno poloblo, ki ju povezuje žuljevo telo. Površino pokriva možganska skorja iz sive možganovine, debela le 2 do 4 milimetre in nagubana v vijuge in brazde; pod njo je bela možganovina iz živčnih vlaken. Vsaka polobla ima čelni, temenski, senčni in zatilni reženj."
   },
   {
    "naslov": "Delovanje",
    "besedilo": "Možgani sprejemajo sporočila čutil, jih povežejo s tem, kar že vemo, in pošiljajo ukaze mišicam in žlezam. V njih je okoli 86 milijard živčnih celic (nevronov), ki si sporočila podajajo z električnimi signali in kemičnimi prenašalci. Leva polobla v glavnem upravlja desno stran telesa, desna pa levo. Mali možgani skrbijo za ravnotežje in usklajene gibe, možgansko deblo pa za dihanje, srčni utrip in druge naloge, ki potekajo same od sebe."
   },
   {
    "naslov": "Zanimivost",
    "besedilo": "Možgani so le okoli 2 % telesne mase, porabijo pa približno petino energije, ki jo telo porabi v mirovanju. Če bi možgansko skorjo razgrnili, bi pokrila približno list časopisa (okoli 0,2 m²); nagubana se prilega v lobanjo."
   },
   {
    "naslov": "Pogoste bolezni in poškodbe",
    "besedilo": "Pretres možganov nastane ob udarcu v glavo: pojavijo se glavobol, slabost, zmedenost ali kratka nezavest, zato mora poškodovanca pregledati zdravnik. Možganska kap nastane, ko se žila v možganih zamaši ali poči in del možganov ostane brez kisika. Povešen kotiček ust, šibka roka ali nerazumljiv govor pomenijo, da je treba takoj poklicati 112. Pogoste so tudi migrena, epilepsija in pri starejših ljudeh demenca, na primer Alzheimerjeva bolezen."
   },
   {
    "naslov": "Kako skrbiš zanje",
    "besedilo": "Pri kolesarjenju, rolanju, smučanju in jahanju nosi čelado. Dovolj spanja (najstniki potrebujejo 8 do 10 ur), gibanje, raznolika hrana in pitje vode ti pomagajo pri učenju in pomnjenju. Alkohol, droge in kajenje možganom škodujejo, posebno dokler se še razvijajo, kar traja do približno 25. leta."
   }
  ]
 },
