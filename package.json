{
  "name": "evklid",
  "version": "0.1.0",
  "private": true,
  "description": "Evklid – AI inštruktor za matematiko, fiziko in kemijo",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "EVKLID_MOCK=1 node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "sim": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning sim/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/eczar": "^5.3.0",
    "@fontsource-variable/el-messiri": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "helmet": "8.3.0",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "pdfjs-dist": "6.5.438",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@fontsource/gelasio": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "lucide-static": "^1.70.0"
  }
}
